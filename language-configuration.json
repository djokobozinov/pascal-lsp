{
  "wordPattern": "(-?\\d*\\.\\d+)|(-?\\d+)|([a-zA-Z_][a-zA-Z0-9_]*)",
  "comments": {
    "blockComment": ["{", "}"],
    "lineComment": "//"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "'", "close": "'" }
  ]
}
