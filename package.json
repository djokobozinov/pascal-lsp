{
  "name": "pascal-lsp",
  "displayName": "Pascal Language Support",
  "publisher": "pascal-lsp",
  "description": "Language support for Pascal: syntax highlighting, go-to-definition, diagnostics via Free Pascal compiler",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/djokobozinov/pascal-lsp.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:pascal"],
  "main": "./client/out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "pascal",
        "aliases": ["Pascal", "pascal"],
        "extensions": [".pas", ".pp"],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pascal.svg",
          "dark": "./icons/pascal.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pascal",
        "scopeName": "source.pascal",
        "path": "./syntaxes/pascal.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "pascal.runProgram",
        "title": "Run Program",
        "category": "Pascal",
        "icon": "$(play)"
      },
      {
        "command": "pascal.buildProgram",
        "title": "Build (Compile)",
        "category": "Pascal",
        "icon": "$(tools)"
      },
      {
        "command": "pascal.showOutput",
        "title": "Show Output",
        "category": "Pascal"
      },
      {
        "command": "pascal.restartServer",
        "title": "Restart Language Server",
        "category": "Pascal"
      },
      {
        "command": "pascal.setFpcPath",
        "title": "Set FPC Path",
        "category": "Pascal"
      }
    ],
    "keybindings": [
      {
        "command": "pascal.runProgram",
        "key": "f5",
        "when": "editorLangId == pascal && !inDebugMode"
      },
      {
        "command": "pascal.buildProgram",
        "key": "ctrl+shift+b",
        "when": "editorLangId == pascal"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pascal.runProgram",
          "when": "editorLangId == pascal",
          "group": "navigation"
        },
        {
          "command": "pascal.buildProgram",
          "when": "editorLangId == pascal",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Pascal",
      "properties": {
        "pascal.fpcPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Free Pascal compiler (fpc). Leave empty to auto-detect from PATH."
        },
        "pascal.compilerFlags": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["-Mdelphi"],
          "description": "Additional flags passed to the Free Pascal compiler (e.g. [\"-Mdelphi\", \"-O2\"])."
        },
        "pascal.runInTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Run compiled programs in the VS Code integrated terminal."
        },
        "pascal.showOutputOnBuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the Pascal output channel when building."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "lint": "echo \"No linter configured\"",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
